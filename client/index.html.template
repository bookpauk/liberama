<!DOCTYPE html>
<html>
  <head>
    <title></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <meta name="description" content="Браузерная онлайн-читалка книг. Поддерживаются форматы: fb2, html, txt, rtf, doc, docx, pdf, epub, mobi.">
    <meta name="keywords" content="онлайн,читалка,fb2,книги,читать,браузер,интернет">
    <style>
      body {
        background-color: black;
        height: 100vh;
        padding: 0;
        margin: 0;
      }

      #start-loader {
        display: flex;
        justify-content: center;
        align-items: center;
        color: #0b0;
        font-size: 22px;
        height: 100%;
      }

      .loader-icon-rotate {
        vertical-align: middle;
        animation: rotating 2s linear infinite;
      }

      @keyframes rotating {
        from {
          transform: rotate(0deg);
        } to {
          transform: rotate(360deg);
        }
      }
    </style>

    <script src="/sw-register.js"></script>
  </head>
  <body>
    <div id="start-loader" style="visibility: hidden">
      <div style="display: flex; flex-direction: row;">
        <div class="loader-icon-rotate" style="height: 28px">&#9203;</div>
        <div style="margin-left: 15px">загрузка приложения...</div>
      </div>
    </div>

    <div id="app" style="display: none"></div>

    <script>
        setTimeout(() => {
          const app = document.getElementById('app');

          if (app && app.style.display === 'none') {
            const loader = document.getElementById('start-loader');
            loader.style.visibility = 'visible';
          }
        }, 1000);
    </script>
  </body>
</html>
